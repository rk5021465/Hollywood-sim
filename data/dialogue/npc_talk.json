    "lines": [
     {
      "s": "john",
      "e": "happy",
      "t": "I still can't believe you're back. Ten years, Peter!"
     },
     {
      "s": "peter",
      "e": "happy",
      "t": "I missed you, man."
     },
     {
      "s": "john",
      "e": "serious",
      "t": "…I copied a lot of powers looking for you. None of them could find you."
     }
    ]
   }
  ],
