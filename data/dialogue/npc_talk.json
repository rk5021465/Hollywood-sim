{
 "talk": {
  "mother": [
   {
    "if": {
     "era": "teen",
     "not_flag": "system_active"
    },
    "lines": [
     {
      "s": "mother",
      "e": "happy",
      "t": "There's my boy. Did you eat? You never eat enough."
     },
     {
      "s": "peter",
      "e": "normal",
      "t": "I ate, Mom."
     },
     {
      "s": "mother",
      "e": "serious",
      "t": "…You're limping again. Was it those crew kids?"
     },
     {
      "s": "peter",
      "e": "sad",
      "t": "It's fine. Really."
     }
    ]
   },
   {
    "if": {
     "era": "teen",
     "flag": "system_active"
    },
    "lines": [
     {
      "s": "mother",
      "e": "normal",
      "t": "You've been training a lot lately."
     },
     {
      "s": "peter",
      "e": "happy",
      "t": "Just trying to get stronger."
     },
     {
      "s": "mother",
      "e": "happy",
      "t": "Your father used to say that. Every single morning."
     }
    ]
   },
   {
    "if": {
     "era": "teen",
     "rel_gt": [
      "mother",
      "trust",
      85
     ]
    },
    "priority": 1,
    "lines": [
     {
      "s": "mother",
      "e": "sad",
      "t": "Peter… whatever you're carrying, you don't have to carry it alone."
     },
     {
      "s": "peter",
      "e": "serious",
      "t": "I know, Mom. One day I'll tell you everything."
     },
     {
      "s": "mother",
      "e": "happy",
      "t": "I'll hold you to that."
     }
    ]
   },
   {
    "if": {
     "era": "adult"
    },
    "lines": [
     {
      "s": "mother",
      "e": "happy",
      "t": "Ten years and you still leave your shoes in the hallway."
     },
     {
      "s": "peter",
      "e": "happy",
      "t": "Some things never change."
     },
     {
      "s": "mother",
      "e": "serious",
      "t": "And some things do. I see how people step aside when you walk by."
     }
    ]
   }
  ],
  "mother_hangout": [
   {
    "lines": [
     {
      "s": "mother",
      "e": "happy",
      "t": "It's been so long since we just walked in the park."
     },
     {
      "s": "peter",
      "e": "happy",
      "t": "We should do this more often."
     },
     {
      "s": "mother",
      "e": "normal",
      "t": "Your father proposed by that fountain, you know."
     }
    ]
   }
  ],
  "john": [
   {
    "if": {
     "era": "teen"
    },
    "lines": [
     {
