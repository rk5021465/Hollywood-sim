    "lines": [
     {
      "s": "mother",
      "e": "happy",
      "t": "My son calls me now? Who are you and what have you done with Peter?"
     },
     {
      "s": "peter",
      "e": "happy",
      "t": "Very funny, Mom."
     },
     {
      "s": "mother",
      "e": "normal",
